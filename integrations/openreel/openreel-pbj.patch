+import { describe, expect, it } from "vitest";
+import { cropForAspectRatio } from "./CropModeView";
+
+describe("cropForAspectRatio", () => {
+  it("creates a square pixel crop for portrait media", () => {
+    const crop = cropForAspectRatio(
+      { x: 0, y: 0, width: 1, height: 1 },
+      1,
+      { width: 720, height: 1280 },
+    );
+
+    expect(crop).toEqual({ x: 0, y: 0.21875, width: 1, height: 0.5625 });
+    expect((crop.width * 720) / (crop.height * 1280)).toBeCloseTo(1);
+  });
+
+  it("creates a portrait crop for landscape media", () => {
+    const crop = cropForAspectRatio(
+      { x: 0, y: 0, width: 1, height: 1 },
+      9 / 16,
+      { width: 1920, height: 1080 },
+    );
+
+    expect(crop.height).toBe(1);
+    expect((crop.width * 1920) / (crop.height * 1080)).toBeCloseTo(9 / 16);
+  });
+});
