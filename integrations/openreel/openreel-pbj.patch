+import { describe, expect, it } from "vitest";
+import {
+  isMobileEditorViewport,
+  keyboardMovedClipStart,
+  PBJ_MOBILE_WORKSPACES,
+  shouldShowStandaloneMobileBlocker,
+} from "./pbj-editor-compat";
+
+describe("PBJ OpenReel editor compatibility", () => {
+  it("uses the narrow workspace layout through iPhone-sized widths", () => {
+    expect(isMobileEditorViewport(390)).toBe(true);
+    expect(isMobileEditorViewport(767)).toBe(true);
+    expect(isMobileEditorViewport(768)).toBe(false);
+    expect(isMobileEditorViewport(844, 390)).toBe(true);
+    expect(isMobileEditorViewport(901, 390)).toBe(false);
+    expect(isMobileEditorViewport(844, 501)).toBe(false);
+    expect(PBJ_MOBILE_WORKSPACES.map((item) => item[0])).toEqual([
+      "stage", "timeline", "media", "inspector",
+    ]);
+  });
+
+  it("moves clips in bounded tenth-second steps", () => {
+    expect(keyboardMovedClipStart(1, "ArrowRight")).toBe(1.1);
+    expect(keyboardMovedClipStart(0.05, "ArrowLeft")).toBe(0);
+  });
+
+  it("never covers a PBJ mobile session with OpenReel's standalone blocker", () => {
+    expect(shouldShowStandaloneMobileBlocker(390, "project-123")).toBe(false);
+    expect(shouldShowStandaloneMobileBlocker(390, null)).toBe(true);
+    expect(shouldShowStandaloneMobileBlocker(1024, null)).toBe(false);
+  });
+});
