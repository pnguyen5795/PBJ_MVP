+import { describe, expect, it, vi } from "vitest";
+import {
+  installPBJSnapshotSync,
+  savePBJSnapshot,
+  snapshotProject,
+} from "./pbj-sync";
+
+const projection = (project: any) => ({
+  schemaVersion: "pbj-openreel-project-v1",
+  authority: {
+    system: "pbj", projectId: "project-1", revision: 2, timelineHash: "hash",
+    snapshotUrl: "/snapshots", latestSnapshotUrl: "/snapshots/latest",
+    exportIntentUrl: "/exports",
+    exportCompletionUrlTemplate: "/exports/{export_id}/complete",
+    loadedFrom: "first_timeline",
+  },
+  project,
+}) as any;
+
+describe("PBJ whole-project snapshot sync", () => {
+  it("saves the complete OpenReel project without browser-only media values", async () => {
+    const project = {
+      id: "project-1",
+      mediaLibrary: { items: [{ id: "asset-1", blob: {}, originalUrl: "blob:temporary" }] },
+      timeline: { tracks: [{ id: "track-1", clips: [{ id: "clip-1", duration: 4 }] }] },
+    } as any;
+    expect((snapshotProject(project) as any).mediaLibrary.items[0].blob).toBeNull();
+    const fetcher = vi.fn().mockResolvedValue({
+      ok: true,
+      json: async () => ({ snapshot_id: "snapshot-1" }),
+    });
+    await savePBJSnapshot(projection(project), project, fetcher as any);
+    const body = JSON.parse(fetcher.mock.calls[0][1].body);
+    expect(body.project.timeline.tracks[0].clips[0].duration).toBe(4);
+    expect(body.schema_version).toBe("pbj-openreel-snapshot-v1");
+  });
+
+  it("flushes a pending edit immediately when the app is backgrounded", async () => {
+    const original = { id: "project-1", timeline: { tracks: [] } } as any;
+    const edited = {
+      id: "project-1",
+      timeline: { tracks: [{ id: "track-1", clips: [{ id: "clip-1" }] }] },
+    } as any;
+    let state = { project: original };
+    let listener: ((next: any, previous: any) => void) | undefined;
+    const store = {
+      getState: () => state,
+      subscribe: (next: typeof listener) => {
+        listener = next;
+        return () => { listener = undefined; };
+      },
+    };
+    const fetcher = vi.fn().mockResolvedValue({
+      ok: true,
+      json: async () => ({ snapshot_id: "snapshot-background" }),
+    });
+    const stop = installPBJSnapshotSync(
+      projection(original),
+      store as any,
+      10_000,
+      fetcher as any,
+    );
+
+    const previous = state;
+    state = { project: edited };
+    listener?.(state, previous);
+    window.dispatchEvent(new Event("pagehide"));
+
+    await vi.waitFor(() => expect(fetcher).toHaveBeenCalledTimes(1));
+    expect(fetcher.mock.calls[0][1].keepalive).toBe(true);
+    expect(JSON.parse(fetcher.mock.calls[0][1].body).project).toEqual(edited);
+    stop();
+  });
+});
diff --git a/apps/web/src/pbj/pbj-sync.ts b/apps/web/src/pbj/pbj-sync.ts
new file mode 100644
index 0000000..11176ea
--- /dev/null
+++ b/apps/web/src/pbj/pbj-sync.ts
@@ -0,0 +1,89 @@
+// PBJ integration overlay for OpenReel Video revision
+// 5f3c85e5fc223c86060bf4b12e1b4dec58e9b8a9 (MIT).
+import type { Project } from "@openreel/core";
+import type { PBJProjection } from "./pbj-project-loader";
+
+type ProjectState = { project: Project };
+type ProjectStore = {
+  getState(): ProjectState;
+  subscribe(listener: (state: ProjectState, previous: ProjectState) => void): () => void;
+};
+
+export function snapshotProject(project: Project): Project {
+  return JSON.parse(JSON.stringify(project, (key, value) => {
+    if (["blob", "fileHandle", "waveformData"].includes(key)) return null;
+    if (typeof value === "string" && value.startsWith("blob:")) return null;
+    return value;
+  })) as Project;
+}
+
+export async function savePBJSnapshot(
+  projection: PBJProjection,
+  project: Project,
+  fetcher: typeof fetch = fetch,
+  preferKeepalive = false,
+): Promise<{ snapshot_id: string }> {
+  const body = JSON.stringify({
+    schema_version: "pbj-openreel-snapshot-v1",
+    source_timeline_revision: projection.authority.revision,
+    source_timeline_hash: projection.authority.timelineHash,
+    project: snapshotProject(project),
+  });
+  const keepalive = preferKeepalive && new TextEncoder().encode(body).byteLength <= 60_000;
+  const response = await fetcher(projection.authority.snapshotUrl, {
+    method: "POST",
+    credentials: "same-origin",
+    headers: { "Content-Type": "application/json", Accept: "application/json" },
+    body,
+    keepalive,
+  });
+  if (!response.ok) throw new Error(`PBJ snapshot save failed (${response.status})`);
+  return response.json() as Promise<{ snapshot_id: string }>;
+}
+
+export function installPBJSnapshotSync(
+  projection: PBJProjection,
+  store: ProjectStore,
+  debounceMs = 750,
+  fetcher: typeof fetch = fetch,
+): () => void {
+  let timeout: ReturnType<typeof setTimeout> | undefined;
+  let dirty = false;
+
+  const flush = (preferKeepalive = false) => {
+    if (!dirty) return;
+    dirty = false;
+    if (timeout) clearTimeout(timeout);
+    timeout = undefined;
+    void savePBJSnapshot(
+      projection,
+      store.getState().project,
+      fetcher,
+      preferKeepalive,
+    ).catch((error) => {
+      dirty = true;
+      console.error("PBJ could not save the OpenReel project snapshot", error);
+    });
+  };
+
+  const unsubscribe = store.subscribe((state, previous) => {
+    if (state.project === previous.project) return;
+    dirty = true;
+    if (timeout) clearTimeout(timeout);
+    timeout = setTimeout(() => flush(), debounceMs);
+  });
+
+  const handleVisibilityChange = () => {
+    if (document.visibilityState === "hidden") flush(true);
+  };
+  const handlePageHide = () => flush(true);
+  document.addEventListener("visibilitychange", handleVisibilityChange);
+  window.addEventListener("pagehide", handlePageHide);
+
+  return () => {
+    if (timeout) clearTimeout(timeout);
+    document.removeEventListener("visibilitychange", handleVisibilityChange);
+    window.removeEventListener("pagehide", handlePageHide);
+    unsubscribe();
+  };
+}
