+export interface CropRect {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+export function cropForAspectRatio(
+  crop: CropRect,
+  ratio: number,
+  videoSize: { width: number; height: number },
+): CropRect {
+  if (videoSize.width <= 0 || videoSize.height <= 0) return crop;
+  const currentAspect =
+    (crop.width * videoSize.width) / (crop.height * videoSize.height);
+  if (currentAspect > ratio) {
+    const newWidth =
+      (crop.height * ratio * videoSize.height) / videoSize.width;
+    return { ...crop, x: crop.x + (crop.width - newWidth) / 2, width: newWidth };
+  }
+  const newHeight =
+    (crop.width * videoSize.width) / (ratio * videoSize.height);
+  return { ...crop, y: crop.y + (crop.height - newHeight) / 2, height: newHeight };
+}
